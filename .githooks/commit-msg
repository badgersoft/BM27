#!/bin/sh
# Stamp the commit message with its version, as a "Version: x.y.z" trailer.
# Merge commits are left alone (git writes their message itself).
git rev-parse -q --verify MERGE_HEAD >/dev/null && exit 0
v=$(git show :project.godot 2>/dev/null | sed -n 's/^config\/version="\(.*\)"/\1/p')
[ -n "$v" ] && git interpret-trailers --in-place --if-exists replace --trailer "Version: $v" "$1"
exit 0
